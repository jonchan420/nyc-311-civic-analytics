  {
   "id": "h28",
   "question": "What counts as an unusual month?",
   "expect": {
    "kind": "explain",
    "docs": [
     "unusual-months"
    ]
   },
   "rules_route": "explain",
   "numbers": null,
   "runs": [
    {
     "kind": "explain",
     "tool": null,
     "params": null,
     "text": "An unusual month is when a complaint type records more than 3 times its typical month, where the typical month is defined as the median over the 12 months before the period being looked at. Small categories with fewer than 20 requests a month aren't checked because small numbers can swing easily. A flagged month might be due to a one-off event, a campaign, or a change in how an agency records requests. The counts alone can't explain these variations.",
     "options": [],
     "routed_by": "rules",
     "written_by": "model",
     "unsupported_numbers": [],
     "model_draft_rejected": false,
