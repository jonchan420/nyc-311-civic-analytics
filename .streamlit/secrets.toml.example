# Ask 311 runs offline (rules and templates, no model, no cost) unless both
# ANTHROPIC_API_KEY and ASK_PASSCODE are set. To turn on Claude, copy this file
# to .streamlit/secrets.toml (git-ignored) for a local run, or paste the lines
# into the deployed app's Settings > Secrets on Streamlit Community Cloud.
ANTHROPIC_API_KEY = "sk-ant-..."
ASK_PASSCODE = "a long passphrase you share only with people who should use the model"

# Optional. Limits are for the whole app per day, and reset when it restarts,
# so also set a monthly spend limit in the Anthropic Console.
ASK_MAX_CALLS_PER_DAY = 20
ASK_MAX_USD_PER_DAY = 1.00
ASK_MODEL = "claude-opus-5-5"
ASK_EFFORT = "low"
